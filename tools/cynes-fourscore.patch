 void NES::load_controller_shifter(bool polling) {
-    if (polling) {
-        memcpy(_controller_shifters, _controller_status, 0x2);
+    if (!polling) {
+        return;
+    }
+
+    for (int port = 0; port < 2; port++) {
+        uint32_t report = uint32_t(_controller_status[port]) << 24;
+
+        if (_four_score) {
+            // Four Score: 8 bits of controller 1/2, 8 bits of controller 3/4,
+            // then the signature (bit 20 set on $4016, bit 19 on $4017).
+            static const uint8_t SIGNATURE[2] = {0x10, 0x20};
+            report |= uint32_t(_controller_status[port + 2]) << 16;
+            report |= uint32_t(SIGNATURE[port]) << 8;
+            report |= 0xFF;
+        } else {
+            // Official standard controllers report 1 after the 8th read.
+            report |= 0x00FFFFFF;
+        }
+
+        _controller_shifters[port] = report;
     }
 }
 
 uint8_t NES::poll_controller(uint8_t player) {
-    uint8_t value = _controller_shifters[player] >> 7;
+    uint8_t value = _controller_shifters[player] >> 31;
 
-    _controller_shifters[player] <<= 1;
+    _controller_shifters[player] = (_controller_shifters[player] << 1) | 1;
 
     return (_open_bus & 0xE0) | value;
 }
